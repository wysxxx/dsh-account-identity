{
  "name": "dsh-account-identity",
  "version": "0.2.0",
  "type": "module",
  "description": "Show a custom display name and avatar in the Harness sidebar account launcher",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "test/regression.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-account"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "license": "MIT",
  "author": "wysxxx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wysxxx/dsh-account-identity.git"
  },
  "homepage": "https://github.com/wysxxx/dsh-account-identity#readme",
  "bugs": {
    "url": "https://github.com/wysxxx/dsh-account-identity/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "avatar",
    "identity",
    "claude-style"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "test": "node test/regression.mjs"
  }
}
